# Optional API keys — recce works without these but unlocks more sources when set.
# Copy this file to `.env` and fill in any keys you have.

# Optional runtime tuning.
# RECCE_USER_AGENT defaults to an honest "recce/<version>" identifier.
RECCE_USER_AGENT=
RECCE_TIMEOUT=12
RECCE_CONCURRENCY=30

# https://haveibeenpwned.com/API/Key  (~$4/mo) — breach lookups for an email
HIBP_API_KEY=

# https://hunter.io/api  (free tier: 25 searches/mo) — domain employee search, email verification
HUNTER_API_KEY=

# https://numverify.com/  (free tier: 100 lookups/mo) — phone carrier/location
NUMVERIFY_API_KEY=

# https://emailrep.io/  (free tier needs no key, but a key gets higher rate limits)
EMAILREP_API_KEY=

# https://leakcheck.io/  (paid) — additional breach lookups
LEAKCHECK_API_KEY=

# https://developer.company-information.service.gov.uk/
# Optional UK company lookup for `recce domain`.
COMPANIES_HOUSE_KEY=

# https://github.com/settings/tokens — a fine-grained token with NO scopes is
# enough. Optional: raises GitHub search limits for email → commit lookups.
GITHUB_TOKEN=

# Investigation monitoring alerts (`recce investigations monitor`) via ntfy.
# Full topic URL; use a long random topic on ntfy.sh or a self-hosted server.
# Alerts carry case ref + counts only unless RECCE_NTFY_DETAIL=1.
RECCE_NTFY_URL=
RECCE_NTFY_TOKEN=
RECCE_NTFY_DETAIL=

# Recce Pro entitlement. Optional until Pro provider calls are enabled.
# The app can also store this at ~/.config/recce/pro_licence.txt.
RECCE_PRO_LICENCE=

# https://developer.vonage.com/en/number-insight/overview  (pay-as-you-go, ~€0.03/lookup)
# Pro-gated live HLR for `recce phone`: current/original carrier, ported status,
# reachability, roaming. Needs both the key and secret.
VONAGE_API_KEY=
VONAGE_API_SECRET=

# Pro-gated provider credentials. Shodan is live for domain DNS intelligence
# (its DNS API needs a paid Shodan Membership); Censys is live for host services
# and TLS certs. The others are recognised by doctor/GUI ahead of provider PRs.
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
SECURITYTRAILS_API_KEY=
# https://platform.censys.io → Account → Personal Access Tokens. Set the org ID
# only on a paid plan; free-tier tokens fail if one is sent.
CENSYS_API_TOKEN=
CENSYS_ORG_ID=

# Network exits (see USAGE.md "Egress control"). Leave commented out to go
# direct. Name exits once, then use the names anywhere a proxy URL goes.
# RECCE_EXITS=tor=socks5h://127.0.0.1:9050;home=socks5h://user:pass@10.0.0.2:1080
# RECCE_PROXY=home                       # every module
# RECCE_USERNAME_PROXY=home              # per module: USERNAME / EMAIL / PHONE / DOMAIN
# RECCE_USERNAME_FALLBACK_PROXY=tor,home # retry bot-walled username probes, in order
