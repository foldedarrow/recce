# Optional API keys — recce works without these but unlocks more sources when set.
# Copy this file to `.env` and fill in any keys you have.

# Optional runtime tuning.
# RECCE_USER_AGENT defaults to an honest "recce/<version>" identifier.
RECCE_USER_AGENT=
RECCE_TIMEOUT=12
RECCE_CONCURRENCY=30

# https://haveibeenpwned.com/API/Key  (~$4/mo) — breach lookups for an email
HIBP_API_KEY=

# https://hunter.io/api  (free tier: 25 searches/mo) — domain employee search, email verification
HUNTER_API_KEY=

# https://numverify.com/  (free tier: 100 lookups/mo) — phone carrier/location
NUMVERIFY_API_KEY=

# https://emailrep.io/  (free tier needs no key, but a key gets higher rate limits)
EMAILREP_API_KEY=

# https://leakcheck.io/  (paid) — additional breach lookups
LEAKCHECK_API_KEY=

# https://developer.company-information.service.gov.uk/
# Optional UK company lookup for `recce domain`.
COMPANIES_HOUSE_KEY=

# Recce Pro entitlement. Optional until Pro provider calls are enabled.
# The app can also store this at ~/.config/recce/pro_licence.txt.
RECCE_PRO_LICENCE=

# https://developer.vonage.com/en/number-insight/overview  (pay-as-you-go, ~€0.03/lookup)
# Pro-gated live HLR for `recce phone`: current/original carrier, ported status,
# reachability, roaming. Needs both the key and secret.
VONAGE_API_KEY=
VONAGE_API_SECRET=

# Pro-gated provider credentials. Shodan is live for domain DNS intelligence;
# the others are recognised by doctor/GUI ahead of provider-specific PRs.
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
SECURITYTRAILS_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
