# recce OSINT web GUI (Streamlit) — systemd unit.
# Install: sudo cp deploy/recce-web.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now recce-web
# Serves on loopback only; front it with a reverse proxy that adds auth.
[Unit]
Description=recce OSINT web GUI (Streamlit, loopback 127.0.0.1:8501)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=youruser
Group=youruser
WorkingDirectory=/opt/recce
Environment=PATH=/opt/recce/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/home/youruser
# Optional API keys (tool works without them); see .env.example for the full list.
EnvironmentFile=-/etc/recce/web.env
ExecStart=/opt/recce/.venv/bin/recce-gui \
  --server.address 127.0.0.1 \
  --server.port 8501 \
  --server.enableCORS false \
  --server.enableXsrfProtection false
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
