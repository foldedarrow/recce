# One-shot: refresh the WhatsMyName and Maigret site databases and Ofcom numbering. Paired with recce-update.timer.
[Unit]
Description=recce: refresh site databases (WhatsMyName, Maigret) and Ofcom numbering
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=youruser
Group=youruser
Environment=HOME=/home/youruser
ExecStart=/opt/recce/.venv/bin/recce update
